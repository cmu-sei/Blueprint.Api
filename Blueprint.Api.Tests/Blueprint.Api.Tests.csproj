<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- As the application projects have it: no implicit usings, nullable reference types off. -->
    <Nullable>disable</Nullable>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Blueprint.Api.Tests</RootNamespace>

    <!--
      Microsoft.Testing.Platform (global.json test.runner): the test project runs as its own test app, under
      `dotnet test` and `dotnet run` alike. xunit.v3 4 and later only run this way on the .NET 10 SDK.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Versions live in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <!-- The four sibling Crucible API clients and the xAPI service, substituted in the per-class factory. -->
    <PackageReference Include="NSubstitute" />
    <!-- Hosts Blueprint.Api in process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- App extra: dials MainHub over a real HubConnection the way blueprint.ui does (Hubs/MainHubConnectionTests). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blueprint.Api\Blueprint.Api.csproj" />
    <!-- The entities and BlueprintContext most tests are written against. -->
    <ProjectReference Include="..\Blueprint.Api.Data\Blueprint.Api.Data.csproj" />
  </ItemGroup>

</Project>
