<!--
  Settings every project in the repository shares. Imported before each project file, so a project
  that needs something different can still override it - Blueprint.Api.Client pins LangVersion 8.0
  for its netstandard2.0 target, and that wins over the value here.
-->
<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!--
      A warning that nobody has to act on is a warning nobody reads, and the compiler and the xUnit
      analyzers report real defects: an unawaited task, a [Theory] with no data, an assertion that
      cannot fail, an awaited call that does not take the test's cancellation token. The build is
      clean today - two CS0618 uses of the obsolete HasCheckConstraint overload were moved to
      ToTable(t => t.HasCheckConstraint(...)) when this was introduced, and there was nothing else -
      so this keeps it that way rather than paying off a backlog.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Restore-time warnings stay warnings. None of these can be acted on from a project file here, so
      promoting them would only make them invisible by blocking every build:

      - NU1901-NU1904 are the NuGet audit. AutoMapper 13 and HtmlSanitizer 9.1.887-beta are the
        direct hits; AutoMapper is pinned deliberately, because version 15+ requires a commercial
        license, and MediatR 12 is pinned for the same reason. The rest is transitive: AngleSharp
        through HtmlSanitizer, Microsoft.OpenApi through Swashbuckle, SQLitePCLRaw through the EF
        SQLite provider, NuGet.Packaging and NuGet.Protocol through Microsoft.Build, and the
        OpenTelemetry packages through Crucible.Common.ServiceDefaults.
      - NU1701 is TinCan 1.3.0, which ships .NET Framework assemblies only. It is the xAPI statement
        library, xAPI is off by default, and there is no net10.0 build of it to move to.
      - NU1510 names three PackageReferences the framework already provides
        (Microsoft.Extensions.Logging, System.Net.Http, System.Text.RegularExpressions). Removing
        them is a real cleanup, but it changes what the application restores, so it does not belong
        in the same commit as the test plumbing.

      This is a real backlog rather than a set of findings that can never be acted on. Check it with
      `dotnet list package` and its vulnerable and transitive switches when bumping a dependency;
      docs/Testing.md spells out the command.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NU1510;NU1701</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
