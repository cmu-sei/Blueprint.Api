<!--
  Central Package Management. Every PackageReference in the repository takes its version from this
  file, so a package that two projects share cannot drift between them.

  The reference that makes this worth having is Microsoft.AspNetCore.Mvc.Testing in
  Blueprint.Api.Tests: it hosts Blueprint.Api in process, so it has to build the host that the
  application's own framework reference expects. Without this file, that version and the
  application's ASP.NET Core version would be two numbers kept in step by hand.

  When this file was introduced every entry was the version the project files already carried, so
  adopting central management changed no dependency. Versions have moved since only to clear the
  NuGet audit (`dotnet list package` with its vulnerable and transitive switches).
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Fail the restore if a project overrides a central version with VersionOverride. Pinning one
      project to a different version of a shared package is exactly the drift this file prevents.
    -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- Application and data access. -->
  <ItemGroup>
    <PackageVersion Include="AutoMapper" Version="13.0.1" /> <!-- DO NOT UPDATE. Version 15+ requires a license. Plan to migrate to something else. -->
    <PackageVersion Include="MediatR" Version="12.4.1" /> <!-- DO NOT UPDATE. Version 13+ requires a license. Plan to migrate to something else. -->
    <PackageVersion Include="Crucible.Common.EntityEvents" Version="0.2.1" />
    <PackageVersion Include="Crucible.Common.ServiceDefaults" Version="0.0.3" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Microsoft.Build" Version="18.0.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Open-XML-SDK" Version="2.9.1" />
    <PackageVersion Include="Z.EntityFramework.Plus.EFCore" Version="10.105.0" />
  </ItemGroup>

  <!-- The Crucible APIs this one calls. Cite and Gallery have no package: their clients are NSwag
       output checked in under Blueprint.Api/Cite.Api.Client and Blueprint.Api/GalleryApiClient. -->
  <ItemGroup>
    <PackageVersion Include="caster.api.client" Version="1.5.0" />
    <PackageVersion Include="Player.Api.Client" Version="3.2.0" />
    <PackageVersion Include="steamfitter.api.client" Version="3.11.0" />
    <PackageVersion Include="TinCan" Version="1.3.0" />
  </ItemGroup>

  <!-- EF Core and its providers. All four providers ship in the image: Postgres is production, and
       Database:Provider selects among them. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <!-- ASP.NET Core, diagnostics and API surface. -->
  <ItemGroup>
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Sqlite" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="IdentityServer4.AccessTokenValidation" Version="3.0.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.0.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="10.0.1" />
  </ItemGroup>

  <!-- Legacy references the framework now provides. NU1510 reports all three; they are kept until
       removing them can be its own change. -->
  <ItemGroup>
    <PackageVersion Include="runtime.native.System.Net.Http" Version="4.3.1" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <!-- The generated client, which targets netstandard2.0 and is released separately. -->
  <ItemGroup>
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

  <!-- Test-only. -->
  <ItemGroup>
    <!-- Hosts the application in process for the endpoint tests. Tied to the ASP.NET Core version, so
         it tracks Microsoft.AspNetCore.Authentication.JwtBearer above rather than the test-tool
         versions around it. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- The SignalR client, for connecting to MainHub the way the Angular UI does. Tied to the
         ASP.NET Core version for the same reason Mvc.Testing is: it has to speak the protocol the
         hosted server negotiates. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <!-- Coverage collection, and inert until it is asked for: it is a VSTest data collector, so a
         plain `dotnet test` neither instruments the assembly nor pays for it. `scripts/coverage.sh`
         is what turns it on. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!-- Security pins. Blueprint.Api references these only to raise a package that otherwise arrives
       through another dependency at a vulnerable version; the test project inherits them through
       its project reference. Each can go once the dependency that brings it in carries a fixed
       version of its own. Pinned this way rather than with CentralPackageTransitivePinningEnabled,
       which would turn every entry in this file into a pin and downgrade packages that other
       dependencies need newer (System.ComponentModel.Annotations, Newtonsoft.Json). -->
  <ItemGroup>
    <!-- Through Microsoft.VisualStudio.Web.CodeGeneration.Design, which carries 6.12.1. -->
    <PackageVersion Include="NuGet.Packaging" Version="6.12.5" />
    <PackageVersion Include="NuGet.Protocol" Version="6.12.5" />
    <!-- Through Microsoft.Data.SqlClient, which carries 9.0.11 even under EF Core 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Through Swashbuckle.AspNetCore 10.0.1, which carries 2.3.0. Swashbuckle 10.2.1+ carries
         2.7.5 itself, so this pin can go when Swashbuckle moves. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

</Project>
