<!--
  Coverage settings, used only when a run asks for coverage - `scripts/coverage.sh`, or the manually
  triggered coverage workflow. There is deliberately no threshold anywhere in this file: coverage
  here is a map of where the untested risk is, not a gate. A percentage that has to be met turns
  into tests written to move the percentage, and the exclusions below would be the first thing
  argued about.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Cobertura is what ReportGenerator reads and what every CI service understands. -->
          <Format>cobertura</Format>

          <!-- This repository's own code, both assemblies. Blueprint.Api.Data is separate here -
               unlike vm.api, whose data layer lives inside the API assembly - and it holds the
               entities, the DbContext and the audit-field logic, so leaving it out would hide the
               half of the risk that the endpoint tests exercise hardest. Crucible.Common, the
               Player and Steamfitter clients and the framework are all somebody else's risk, and a
               report that lists them buries the part a reader can act on. Blueprint.Api.Client is
               not in the picture either way: the application does not reference it, so it is never
               loaded. -->
          <Include>[Blueprint.Api]*,[Blueprint.Api.Data]*</Include>

          <!-- Three bodies of generated code, all of them in the application assembly.

               The CITE and Gallery clients are ~40,000 lines of checked-in NSwag output. They are
               excluded by namespace rather than by folder because that is what they are: nothing in
               Cite.Api.Client or Gallery.Api.Client was written here. The one thing this also
               excludes is the 24-line UpdateJsonSerializerSettings partial beside each of them,
               which is a static hook the substituted clients never run anyway.

               EF's migrations are generated, enormous, and exercised by the harness rather than by
               any test's assertions - the template database is migrated once per run, so they would
               report as well covered while proving nothing. They are in their own assembly, which
               Include above already leaves out, and are named here so that stays deliberate rather
               than incidental.

               Both filter kinds are present because they answer to different things: the namespace
               filter catches the compiled types, the file filter catches anything added under those
               folders that lands elsewhere. -->
          <Exclude>[Blueprint.Api]Cite.Api.Client.*,[Blueprint.Api]Gallery.Api.Client.*,[Blueprint.Api.Migrations.PostgreSQL]*</Exclude>
          <ExcludeByFile>**/Cite.Api.Client/**/*.cs,**/GalleryApiClient/**/*.cs,**/Migrations/**/*.cs</ExcludeByFile>

          <!-- Compiler-generated code is not a risk anyone can test, and `[Obsolete]` members are
               ones nobody should be writing a test for. -->
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>

          <!-- Auto-implemented property accessors are skipped. The 49 ViewModels and the 43 entities
               are almost entirely auto-props, and counting each one as a line either way is what
               makes a raw number meaningless: it moves whenever a model grows a field, in whichever
               direction the endpoint tests happen to serialize it. -->
          <SkipAutoProps>true</SkipAutoProps>

          <!-- The test assembly is not the subject. Its own coverage would be near total by
               construction and would swamp the report. -->
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
